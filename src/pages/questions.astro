---
/**
 * WEEKLY QUESTION ARCHIVE (კვირის კითხვები).
 * Questions: src/content/questions/ka/*.md (highest number = this week)   ·   Copy: pages/ka/questions.yaml
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/shared/PageHero.astro';
import CtaBand from '@/components/shared/CtaBand.astro';
import { getLocalized, getPage } from '@/lib/content';
import { QUESTION_TOPICS } from '@/content.config';
import { formatDateKa } from '@/lib/georgian';
import { t } from '@/i18n/ui';

const p = await getPage('questionsPage');
const ui = t();
const questions = (await getLocalized('questions')).sort((a, b) => b.data.number - a.data.number);
const [current, ...archive] = questions;
const topicTag = { fairness: 'tag--red', science: 'tag--teal', money: 'tag--gold', people: 'tag--blue' } as const;
const n = String(archive.length);
---
<BaseLayout title={p.seo.title} description={p.seo.description} ogPhoto="exhibition-talk">
  {questions.length === 0 ? (
    <PageHero slot="hero" label={p.hero.label} title={p.empty.title} accent={p.empty.accent} lead={p.empty.lead} />
  ) : (
    <PageHero slot="hero" label={p.hero.label} title={p.hero.title.replaceAll('{n}', n)} accent={p.hero.accent} lead={p.hero.lead} />
  )}

  {questions.length > 0 && (
  <section id="archive" class="bg-sky sec">
    <div class="wrap stack" style="--stack-gap: 28px" data-archive>
      <div class="row" style="--row-gap: 8px" role="group">
        <button type="button" class="choice" aria-pressed="true" data-topic="all">{ui.faq.all}</button>
        {QUESTION_TOPICS.map((tp) => <button type="button" class="choice" aria-pressed="false" data-topic={tp}>{p.topics[tp] ?? tp}</button>)}
      </div>
      {current && (
        <a href="/#day" class="current">
          <span><span class="tag tag--navy">№{current.data.number} · {ui.archive.thisWeek}</span><br /><span class="display current__q">{current.data.question}</span></span>
          <span class="btn btn--hl">{ui.archive.answerToo}</span>
        </a>
      )}
      <div class="weeks">
        {archive.map((w) => (
          <details class="week" data-topic={w.data.topic} id={`q${w.data.number}`} data-placeholder={w.data.placeholder || undefined}>
            <summary>
              <span class="row" style="--row-gap: 8px; align-items: center"><b class="accent small">№{w.data.number}</b><span class={`tag ${topicTag[w.data.topic]}`}>{p.topics[w.data.topic]}</span></span>
              <span class="display week__q">{w.data.question}</span>
              <span class="small accent week__more">{ui.archive.seeConclusion}</span>
            </summary>
            {w.data.conclusion && <div class="week__c"><b class="xs accent">{ui.archive.conclusion}</b><p>„{w.data.conclusion}“</p><span class="xs muted">{w.data.studios} · {formatDateKa(w.data.week)}</span></div>}
          </details>
        ))}
      </div>
    </div>
  </section>
  )}


  <CtaBand title={p.cta.title} accent={p.cta.accent} button={p.cta.button} />
</BaseLayout>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-archive]')) {
    const btns = root.querySelectorAll<HTMLElement>('button[data-topic]');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      root.querySelectorAll<HTMLElement>('details[data-topic]').forEach((d) => (d.hidden = b.dataset.topic !== 'all' && d.dataset.topic !== b.dataset.topic));
    }));
  }
</script>
<style>
  .current { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; background: var(--color-navy); border-radius: var(--radius-card); padding: 28px 32px; text-decoration: none; }
  .current__q { color: var(--color-white); font-size: clamp(22px, 2.4vw, 30px); line-height: 1.2; }
  .weeks { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 16px; align-items: start; }
  .week { background: var(--color-white); border-radius: 22px; padding: 22px; border: 3px solid transparent; }
  .week[open] { border-color: var(--color-navy); }
  .week[hidden] { display: none; }
  .week summary { list-style: none; cursor: pointer; display: flex; flex-direction: column; gap: 10px; }
  .week summary::-webkit-details-marker { display: none; }
  .week__q { font-size: 20px; line-height: 1.3; }
  .week[open] .week__more { display: none; }
  .week__c { margin-top: 14px; background: var(--color-bg-ice); border-radius: var(--radius-control); padding: 16px; color: var(--color-navy); }
</style>
